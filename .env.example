NODE_ENV=development
PORT=3010
AUTH_JWKS_URL=http://parc-auth-customer:3001/.well-known/jwks.json
JWT_ISSUER=https://auth.parc.invalid
JWT_AUDIENCE=mobile-bff
TENANT_ADMIN_URL=http://parc-tenant-admin:3002
LEDGER_URL=http://parc-ledger:3003
PAYMENT_URL=http://parc-payment:3004
LENDING_URL=http://parc-lending:3005
SAVINGS_URL=http://parc-savings:3006
AUTH_CUSTOMER_URL=http://parc-auth-customer:3001
DOWNSTREAM_TIMEOUT_MS=3000
# Downstream calls use Auth-issued tokens: delegated for customer requests,
# service-only before login. This service's ES256 key is registered (public
# half) in Auth & Customer SERVICE_CLIENT_KEYS_JSON under "parc-mobile-bff".
AUTH_TOKEN_URL=http://127.0.0.1:3001/internal/v1/oauth/token
SERVICE_CLIENT_KEY_ID=parc-mobile-bff-1
SERVICE_CLIENT_PRIVATE_KEY_BASE64=replace-with-base64-pkcs8-es256-private-key
